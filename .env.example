# ===== LLM 提供商配置 =====
# 可选值: openai | anthropic | ollama | zhipu
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ===== Embedding 提供商配置 =====
# 可选值: openai | ollama | zhipu（Embedding 与 LLM 可分别配置）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ===== API Key（按需填写） =====
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# ===== 智谱 AI（开放平台: https://open.bigmodel.cn/） =====
# 使用智谱时设置 LLM_PROVIDER=zhipu / EMBEDDING_PROVIDER=zhipu，并填入：
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/anthropic
# OpenAI 兼容对话接口（框架模式 LangChain ChatOpenAI 使用）
ZHIPU_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4/embeddings

# 官方 Anthropic 接口地址（使用 anthropic 提供商时生效）
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ===== Ollama 配置 =====
OLLAMA_BASE_URL=http://localhost:11434

# ===== 文档分块参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ===== 检索参数 =====
TOP_K=4

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
